{
  "name": "movie-monkey",
  "productName": "Movie Monkey",
  "version": "2.0.0-alpha.2",
  "description": "A beautiful, local-first movie & TV library for your desktop.",
  "author": "Shrihari",
  "license": "CC0-1.0",
  "homepage": "https://getmoviemonkey.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrihari/moviemonkey.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "tsc --noEmit && vite build",
    "preview:web": "vite --mode mock",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "demo": "node scripts/make-demo-library.mjs",
    "tauri": "tauri",
    "format": "prettier --write src && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit && prettier --check src && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:live": "cargo test --manifest-path src-tauri/Cargo.toml --test identify_live -- --ignored --nocapture",
    "icon": "node scripts/make-icon.mjs",
    "release:mac": "bash scripts/release-mac.sh",
    "build:ffmpeg": "bash scripts/build-ffmpeg.sh",
    "build:tv-demo": "bash scripts/build-tv-demo.sh"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
