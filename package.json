{
  "name": "movie-monkey",
  "productName": "Movie Monkey",
  "version": "0.2.0",
  "description": "A clean and simple, open source movie manager.",
  "email": "<chimp@getmoviemonkey.com>",
  "author": {
    "name": "Shrihari",
    "email": "iamshrihari@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shrihari/moviemonkey.git"
  },
  "license": "CC0-1.0",
  "homepage": "http://getmoviemonkey.com/",
  "scripts": {
    "watch": "webpack --watch",
    "start": "electron ./app --enable-logging",
    "dev": "NODE_ENV='development' npm run start",
    "dist": "electron-builder -mwl --x64",
    "release": "electron-builder --mac -p always"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "episode-parser": "^1.2.0",
    "filewalker": "^0.1.3",
    "image-downloader": "^4.3.0",
    "nedb": "^1.8.0",
    "omdbapi": "^4.0.0",
    "opensubtitles-api": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tmdbapi": "^1.0.2"
  },
  "build": {
    "appId": "com.moviemonkey",
    "files": [
      "**/*",
      "!node_modules${/*}"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shrihari",
        "repo": "moviemonkey"
      }
    ]
  }
}
